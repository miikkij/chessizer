{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SoundPresets",
  "type": "object",
  "properties": {
    "version": {
      "type": "string"
    },
    "library": {
      "type": "object",
      "properties": {
        "preferred": {
          "type": "string"
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "preferred"
      ]
    },
    "presets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "engine": {
            "type": "object"
          },
          "mapping": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "name",
          "engine",
          "mapping"
        ]
      }
    },
    "defaults": {
      "type": "object"
    }
  },
  "required": [
    "version",
    "library",
    "presets"
  ]
}