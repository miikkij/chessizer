{
  "name": "chessizer",
  "private": true,
  "version": "0.0.0",
  "description": "Hear chess positions through browser audio while exploring the board and move history.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miikkij/chessizer.git"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,wav -c blue,magenta \"vite\" \"pnpm run wav:server\"",
    "dev:frontend": "vite",
    "wav:server": "node scripts/wav-server.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b && tsc --noEmit -p tsconfig.test.json",
    "test": "tsx --tsconfig tsconfig.test.json --test tests/*.test.ts tests/*.test.tsx",
    "preview": "vite preview",
    "docker:build": "docker build -t chess-sound .",
    "docker:run": "docker run -p 8080:80 chess-sound"
  },
  "dependencies": {
    "@lichess-org/chessground": "^10.4.2",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-slider": "^1.5.0",
    "@radix-ui/react-slot": "^1.4.0",
    "ajv": "^8.20.0",
    "axios": "^1.20.0",
    "chess.js": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.53.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hot-toast": "^2.6.1",
    "tailwind-merge": "^3.7.0",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0",
    "pnpm": ">=12.10.1 <13"
  },
  "packageManager": "pnpm@12.10.1"
}
