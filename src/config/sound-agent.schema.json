{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chessizer.local/schemas/sound-agent.schema.json",
  "title": "Chessizer browser sound configuration",
  "description": "The active Tone.js configuration. Unknown fields and unsupported graph nodes are rejected. Voice references and ordered ranges are checked by the shared runtime validator.",
  "type": "object",
  "properties": {
    "version": {
      "const": "1.0"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "transport": {
      "type": "object",
      "properties": {
        "bpm": {
          "type": "number",
          "minimum": 1,
          "maximum": 400
        },
        "swing": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "timeSignature": {
          "type": "array",
          "items": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            },
            {
              "enum": [
                1,
                2,
                4,
                8,
                16,
                32
              ]
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "latencyHint": {
          "enum": [
            "interactive",
            "balanced",
            "playback"
          ]
        },
        "quantize": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "startOffset": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "maxConcurrentVoices": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "onsetOffsetMs": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 60000
          },
          "minItems": 2,
          "maxItems": 2
        },
        "hardHeadroomDb": {
          "type": "number",
          "minimum": 0,
          "maximum": 60
        },
        "clipLengthMs": {
          "type": "number",
          "minimum": 1,
          "maximum": 600000
        },
        "voicePriority": {
          "type": "array",
          "items": {
            "enum": [
              "pawn",
              "knight",
              "bishop",
              "rook",
              "queen",
              "king"
            ]
          },
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "voices": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "#/definitions/voice"
      }
    },
    "mappings": {
      "type": "object",
      "properties": {
        "pieceEarcons": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "pawn",
              "knight",
              "bishop",
              "rook",
              "queen",
              "king"
            ]
          },
          "additionalProperties": {
            "$ref": "#/definitions/earcon"
          }
        }
      },
      "required": [
        "pieceEarcons"
      ],
      "additionalProperties": false
    },
    "colors": {
      "type": "object",
      "properties": {
        "white": {
          "type": "object",
          "properties": {
            "pan": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "pitchShift": {
              "type": "number",
              "minimum": -48,
              "maximum": 48
            },
            "filterTint": {
              "type": "object",
              "properties": {
                "frequency": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 24000
                }
              },
              "required": [
                "frequency"
              ],
              "additionalProperties": false
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "black": {
          "type": "object",
          "properties": {
            "pan": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "pitchShift": {
              "type": "number",
              "minimum": -48,
              "maximum": 48
            },
            "filterTint": {
              "type": "object",
              "properties": {
                "frequency": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 24000
                }
              },
              "required": [
                "frequency"
              ],
              "additionalProperties": false
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "traversal": {
      "type": "object",
      "properties": {
        "strategy": {
          "enum": [
            "rowSequential",
            "columnSequential",
            "spiralFromCenter",
            "ringsFromKing",
            "randomSeeded",
            "customList"
          ]
        },
        "params": {
          "type": "object",
          "properties": {
            "rowsPerTick": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            "colsPerTick": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            "cellsPerTick": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "side": {
              "enum": [
                "turn",
                "white",
                "black"
              ]
            },
            "seed": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                }
              ]
            },
            "order": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-h][1-8]$"
              },
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "tickDurationMs": {
          "type": "number",
          "minimum": 250,
          "maximum": 5000
        },
        "concurrency": {
          "type": "object",
          "properties": {
            "maxVoices": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "onsetOffsetMs": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 60000
              },
              "minItems": 2,
              "maxItems": 2
            },
            "intensityScaling": {
              "type": "object",
              "properties": {
                "minFactor": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "maxFactor": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "curve": {
                  "enum": [
                    "linear",
                    "power",
                    "smoothstep"
                  ]
                },
                "exponent": {
                  "type": "number",
                  "minimum": 0.01,
                  "maximum": 10
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "strategy"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "strategy": {
                "const": "customList"
              }
            },
            "required": [
              "strategy"
            ]
          },
          "then": {
            "required": [
              "params"
            ],
            "properties": {
              "params": {
              "type": "object",
                "required": [
                  "order"
                ]
              }
            }
          }
        }
      ]
    },
    "events": {
      "type": "object",
      "properties": {
        "check": {
          "type": "object",
          "properties": {
            "voiceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "white": {
              "type": "object",
              "properties": {
                "pan": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1
                },
                "glide": {
                  "type": "object",
                  "properties": {
                    "from": {
                      "type": "string",
                      "pattern": "^[A-G](?:#|b)?-?[0-9]$"
                    },
                    "to": {
                      "type": "string",
                      "pattern": "^[A-G](?:#|b)?-?[0-9]$"
                    },
                    "durationMs": {
                      "type": "number",
                      "minimum": 0.1,
                      "maximum": 60000
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "black": {
              "type": "object",
              "properties": {
                "pan": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1
                },
                "glide": {
                  "type": "object",
                  "properties": {
                    "from": {
                      "type": "string",
                      "pattern": "^[A-G](?:#|b)?-?[0-9]$"
                    },
                    "to": {
                      "type": "string",
                      "pattern": "^[A-G](?:#|b)?-?[0-9]$"
                    },
                    "durationMs": {
                      "type": "number",
                      "minimum": 0.1,
                      "maximum": 60000
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [
            "voiceId"
          ],
          "additionalProperties": false
        },
        "capture": {
          "type": "object",
          "properties": {
            "voiceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "white": {
              "type": "object",
              "properties": {
                "pan": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1
                },
                "note": {
                  "type": "string",
                  "pattern": "^[A-G](?:#|b)?-?[0-9]$"
                },
                "durationMs": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 60000
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "black": {
              "type": "object",
              "properties": {
                "pan": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1
                },
                "note": {
                  "type": "string",
                  "pattern": "^[A-G](?:#|b)?-?[0-9]$"
                },
                "durationMs": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 60000
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [
            "voiceId"
          ],
          "additionalProperties": false
        },
        "checkmate": {
          "type": "object",
          "properties": {
            "sequence": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "object",
                "properties": {
                  "voiceId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "note": {
                    "type": "string",
                    "pattern": "^[A-G](?:#|b)?-?[0-9]$"
                  },
                  "t": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 60000
                  },
                  "d": {
                    "type": "number",
                    "minimum": 0.1,
                    "maximum": 60000
                  },
                  "levelDb": {
                    "type": "number",
                    "minimum": -100,
                    "maximum": 12
                  }
                },
                "required": [
                  "voiceId",
                  "note",
                  "t",
                  "d"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "scaling": {
      "type": "object",
      "properties": {
        "drone": {
          "type": "object",
          "properties": {
            "voiceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "baseNote": {
              "type": "string",
              "pattern": "^[A-G](?:#|b)?-?[0-9]$"
            },
            "brightnessByMaterial": {
              "type": "object",
              "properties": {
                "slopeCentroidHzPerPoint": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10000
                },
                "minHz": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 24000
                },
                "maxHz": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 24000
                }
              },
              "required": [
                "slopeCentroidHzPerPoint",
                "minHz",
                "maxHz"
              ],
              "additionalProperties": false
            },
            "levelDb": {
              "type": "number",
              "minimum": -100,
              "maximum": 12
            }
          },
          "required": [
            "voiceId",
            "baseNote"
          ],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "diagnostics": {
      "type": "object",
      "properties": {
        "logLevel": {
          "enum": [
            "off",
            "error",
            "warn",
            "info"
          ]
        },
        "emitScheduleLog": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "name",
    "voices",
    "mappings",
    "traversal"
  ],
  "additionalProperties": false,
  "definitions": {
    "voice": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "Synth",
            "PolySynth",
            "Sampler",
            "Player"
          ]
        },
        "voice": {
          "enum": [
            "Synth",
            "AMSynth",
            "FMSynth"
          ]
        },
        "options": {
          "type": "object"
        },
        "chain": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/effect"
          },
          "maxItems": 8
        },
        "toDestination": {
          "type": "boolean"
        },
        "volumeDb": {
          "type": "number",
          "minimum": -100,
          "maximum": 12
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "Synth",
                  "PolySynth"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "options": {
                "$ref": "#/definitions/synthOptions"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "Sampler"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "options"
            ],
            "properties": {
              "options": {
                "$ref": "#/definitions/samplerOptions"
              }
            },
            "not": {
              "required": [
                "voice"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "Player"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "options"
            ],
            "properties": {
              "options": {
                "$ref": "#/definitions/playerOptions"
              }
            },
            "not": {
              "required": [
                "voice"
              ]
            }
          }
        }
      ]
    },
    "synthOptions": {
      "type": "object",
      "properties": {
        "oscillator": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "pattern": "^(?:(?:am|fm|fat)?(?:sine|square|triangle|sawtooth)(?:[1-9][0-9]*)?|pulse|pwm)$"
            },
            "phase": {
              "type": "number",
              "minimum": 0,
              "maximum": 360
            },
            "detune": {
              "type": "number",
              "minimum": -4800,
              "maximum": 4800
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "spread": {
              "type": "number",
              "minimum": 0,
              "maximum": 120
            },
            "width": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "modulationFrequency": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 20000
            },
            "partials": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "minItems": 1,
              "maxItems": 64
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "envelope": {
          "type": "object",
          "properties": {
            "attack": {
              "type": "number",
              "minimum": 0,
              "maximum": 60
            },
            "decay": {
              "type": "number",
              "minimum": 0,
              "maximum": 60
            },
            "sustain": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "release": {
              "type": "number",
              "minimum": 0,
              "maximum": 60
            },
            "attackCurve": {
              "enum": [
                "linear",
                "exponential",
                "sine",
                "cosine",
                "bounce",
                "ripple",
                "step"
              ]
            },
            "decayCurve": {
              "enum": [
                "linear",
                "exponential"
              ]
            },
            "releaseCurve": {
              "enum": [
                "linear",
                "exponential",
                "sine",
                "cosine",
                "bounce",
                "ripple",
                "step"
              ]
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "portamento": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "detune": {
          "type": "number",
          "minimum": -4800,
          "maximum": 4800
        },
        "volume": {
          "type": "number",
          "minimum": -100,
          "maximum": 12
        },
        "harmonicity": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 32
        },
        "modulationIndex": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "modulation": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "pattern": "^(?:(?:am|fm|fat)?(?:sine|square|triangle|sawtooth)(?:[1-9][0-9]*)?|pulse|pwm)$"
            },
            "phase": {
              "type": "number",
              "minimum": 0,
              "maximum": 360
            },
            "detune": {
              "type": "number",
              "minimum": -4800,
              "maximum": 4800
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "spread": {
              "type": "number",
              "minimum": 0,
              "maximum": 120
            },
            "width": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "modulationFrequency": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 20000
            },
            "partials": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "minItems": 1,
              "maxItems": 64
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "modulationEnvelope": {
          "type": "object",
          "properties": {
            "attack": {
              "type": "number",
              "minimum": 0,
              "maximum": 60
            },
            "decay": {
              "type": "number",
              "minimum": 0,
              "maximum": 60
            },
            "sustain": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "release": {
              "type": "number",
              "minimum": 0,
              "maximum": 60
            },
            "attackCurve": {
              "enum": [
                "linear",
                "exponential",
                "sine",
                "cosine",
                "bounce",
                "ripple",
                "step"
              ]
            },
            "decayCurve": {
              "enum": [
                "linear",
                "exponential"
              ]
            },
            "releaseCurve": {
              "enum": [
                "linear",
                "exponential",
                "sine",
                "cosine",
                "bounce",
                "ripple",
                "step"
              ]
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "samplerOptions": {
      "type": "object",
      "properties": {
        "urls": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^(?:[A-G](?:#|b)?-?[0-9]|[0-9]{1,3})$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "baseUrl": {
          "type": "string"
        },
        "attack": {
          "type": "number",
          "minimum": 0,
          "maximum": 60
        },
        "release": {
          "type": "number",
          "minimum": 0,
          "maximum": 60
        },
        "curve": {
          "enum": [
            "linear",
            "exponential"
          ]
        },
        "volume": {
          "type": "number",
          "minimum": -100,
          "maximum": 12
        }
      },
      "required": [
        "urls"
      ],
      "additionalProperties": false
    },
    "playerOptions": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "loop": {
          "type": "boolean"
        },
        "autostart": {
          "const": false
        },
        "reverse": {
          "type": "boolean"
        },
        "playbackRate": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 4
        },
        "loopStart": {
          "type": "number",
          "minimum": 0,
          "maximum": 600
        },
        "loopEnd": {
          "type": "number",
          "minimum": 0,
          "maximum": 600
        },
        "fadeIn": {
          "type": "number",
          "minimum": 0,
          "maximum": 60
        },
        "fadeOut": {
          "type": "number",
          "minimum": 0,
          "maximum": 60
        },
        "volume": {
          "type": "number",
          "minimum": -100,
          "maximum": 12
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "properties": {
        "t": {
          "type": "number",
          "minimum": 0,
          "maximum": 60000
        },
        "d": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 60000
        },
        "v": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "n": {
          "type": "string",
          "pattern": "^[+-]?[0-9]{1,2}$"
        },
        "chord": {
          "type": "array",
          "items": {
            "type": "string",
