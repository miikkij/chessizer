{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GamePresetConfiguration",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema version"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "When this configuration was generated"
    },
    "description": {
      "type": "string",
      "description": "Description of this configuration"
    },
    "presets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for this preset"
          },
          "name": {
            "type": "string",
            "description": "Human-readable name"
          },
          "type": {
            "type": "string",
            "enum": ["fixed", "generator"],
            "description": "Whether this is a fixed position or generated"
          },
          "pgn": {
            "type": "string",
            "description": "PGN format game data"
          },
          "generator": {
            "type": "object",
            "description": "Generator configuration for dynamic presets"
          },
          "note": {
            "type": "string",
            "description": "Description or notes about this preset"
          }
        },
        "required": ["id", "name", "type"]
      }
    }
  },
  "required": ["version", "presets"]
}